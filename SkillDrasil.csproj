<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Environment.props" Condition="Exists('Environment.props')" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SkillDrasil</AssemblyName>
    <RootNamespace>SkillDrasil</RootNamespace>
    <VALHEIM_INSTALL Condition="'$(VALHEIM_INSTALL)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</VALHEIM_INSTALL>
    <Managed>$(VALHEIM_INSTALL)\valheim_Data\Managed</Managed>
    <BepInExDir>$(VALHEIM_INSTALL)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <EmbeddedResource Include="assets/atlas.png" LogicalName="SkillDrasil.atlas.png" />
    <EmbeddedResource Include="assets/atlas.txt" LogicalName="SkillDrasil.atlas.txt" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim" HintPath="$(Managed)\assembly_valheim.dll" Publicize="true" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(Managed)\assembly_utils.dll" Publicize="true" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(Managed)\assembly_guiutils.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine*.dll" Private="false" />
    <Reference Include="netstandard" HintPath="$(Managed)\netstandard.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="Jotunn" HintPath="$(BepInExDir)\plugins\Jotunn\Jotunn.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(BepInExDir)\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\SkillDrasil" />
  </Target>
</Project>
